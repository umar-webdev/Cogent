{
  "extends": "@cogent/config/tsconfig",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": "../..",
    "paths": {
      "@cogent/contracts": ["packages/contracts/src/index.ts"],
      "@cogent/block-registry": ["packages/block-registry/src/index.ts"],
      "@cogent/content": ["content/tracks/index.ts"],
      "@cogent/grading-engine": ["packages/grading-engine/src/index.ts"],
      "@cogent/ui": ["packages/ui/src/index.tsx"]
    }
  },
  "include": ["src"]
}
